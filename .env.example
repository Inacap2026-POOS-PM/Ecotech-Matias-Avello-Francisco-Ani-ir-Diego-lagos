# Copia este archivo como .env solo si todavia no tienes uno.
# Completa los datos de Connect > Session pooler de Supabase.
# La contrasena es la de la BASE DE DATOS, no la de tu cuenta de Supabase.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
# Puedes dejarla vacia: Python la pedira al iniciar sin mostrarla en pantalla.
SUPABASE_DB_PASSWORD=
# Deja esta variable vacia para usar el certificado supabase-ca.crt incluido.
# Opcional: otro certificado CA; las rutas relativas parten de main.py.
# La conexion verifica siempre la identidad del servidor con SSL verify-full.
SUPABASE_SSLROOTCERT=
# Si necesitas usar una clave Fernet existente, indica su ruta aqui.
# Conserva la clave original para poder migrar las cuentas antiguas.
ECOTECH_FERNET_KEY_FILE=

# Base SQLite para el respaldo local de la etapa E3.
# Una ruta relativa parte de la carpeta de main.py, no de la terminal.
# Si la variable falta o queda vacia, se usa datos/ecotech.sqlite3.
ECOTECH_SQLITE_PATH=datos/ecotech.sqlite3

# ExchangeRate-API Open Access no requiere clave, cuenta ni tarjeta.
# El cliente HTTP se incorporara en la parte correspondiente de la entrega.
